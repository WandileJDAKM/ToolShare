@{ ViewData["Title"] = "Sign in"; }
<h1>Sign in</h1>
<form method="post" class="form" novalidate>
  <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" value="@(ViewBag.Email as string)" required></div>
  <div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
  <button class="btn">Sign in</button>
</form>
<p>New here? <a asp-action="Register">Create an account</a>.</p>
